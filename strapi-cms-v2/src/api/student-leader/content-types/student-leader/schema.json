{
  "kind": "collectionType",
  "collectionName": "student_leaders",
  "info": {
    "singularName": "student-leader",
    "pluralName": "student-leaders",
    "displayName": "Student Leader",
    "description": "Student leadership team with photos and roles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "graduation_year": {
      "type": "string",
      "required": true,
      "maxLength": 4
    },
    "role": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "department": {
      "type": "enumeration",
      "enum": ["hardware", "software", "business", "outreach", "leadership"],
      "required": true
    },
    "profile_picture": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "bio": {
      "type": "text",
      "maxLength": 500
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "is_current": {
      "type": "boolean",
      "default": true
    },
    "linkedin_url": {
      "type": "string",
      "required": false
    },
    "github_url": {
      "type": "string",
      "required": false
    }
  }
}
