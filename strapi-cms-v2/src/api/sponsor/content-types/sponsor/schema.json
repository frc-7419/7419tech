{
  "kind": "collectionType",
  "collectionName": "sponsors",
  "info": {
    "singularName": "sponsor",
    "pluralName": "sponsors",
    "displayName": "Sponsor",
    "description": "Team sponsors and their logos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 100
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "website_url": {
      "type": "string",
      "required": false
    },
    "tier": {
      "type": "enumeration",
      "enum": ["platinum", "gold", "silver", "bronze", "supporter"],
      "required": true,
      "default": "supporter"
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
