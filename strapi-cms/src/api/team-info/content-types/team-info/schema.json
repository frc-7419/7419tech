{
  "kind": "singleType",
  "collectionName": "team_infos",
  "info": {
    "singularName": "team-info",
    "pluralName": "team-infos",
    "displayName": "Team Info",
    "description": "General information about the 7419 Tech team"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "team_name": {
      "type": "string",
      "required": true,
      "maxLength": 50,
      "default": "7419 Tech"
    },
    "team_number": {
      "type": "string",
      "required": true,
      "maxLength": 10,
      "default": "7419"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "website": {
      "type": "string"
    },
    "team_photo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "team_logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "founding_year": {
      "type": "integer",
      "default": 2018
    },
    "current_season": {
      "type": "string",
      "default": "2024-2025"
    },
    "total_members": {
      "type": "integer",
      "default": 0
    },
    "active_projects": {
      "type": "integer",
      "default": 0
    },
    "social_links": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    }
  }
}
